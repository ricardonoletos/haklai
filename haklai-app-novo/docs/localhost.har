          "cookies": [],
          "content": {
            "size": 18624,
            "mimeType": "text/css",
            "compression": 0,
            "text": "/**\r\n * Haklai App - CSS Principal\r\n * Baseado exatamente no design do test-checkpoint-final.html\r\n * \r\n * @package HaklaiApp\r\n * @author Ricardo Sarmento\r\n * @version 2.0.0\r\n */\r\n\r\n/* Projeto: Haklai Church — Plugin WordPress Modular - Desenvolvido por: Ricardo Sarmento - https://linx.pt */\r\n\r\n/* ===== VARIÁVEIS CSS ===== Editado Ricardo Noleto Sarmento - 05/10/2025*/\r\n:root {\r\n    /* Cores principais - Esquema monocromático */\r\n    --primary-color: #ffffff;\r\n    --secondary-color: #5a1a5d;\r\n    --accent-color: #fe1515;\r\n    --danger-color: #fe1515;\r\n    --success-color: #2faf14;\r\n    --info-color: #6a2a6d;\r\n    --warning-color: #9a3a9d;\r\n    \r\n    /* Cores de texto */\r\n    --text-primary: #3f1042;\r\n    --text-secondary: #5a1a5d;\r\n    --text-muted: #7d2a80;\r\n    --text-light: #9a3a9d;\r\n    \r\n    /* Cores de fundo */\r\n    --bg-primary: #f8f5ff;\r\n    --bg-secondary: #f0ebff;\r\n    --bg-tertiary: #e8e0ff;\r\n    --bg-dark: #3f1042;\r\n    \r\n    /* Bordas */\r\n    --border-color: #d4c7ff;\r\n    --border-radius: 16px;\r\n    --border-radius-sm: 12px;\r\n    --border-radius-lg: 20px;\r\n    \r\n    /* Sombras - Adaptadas para o esquema monocromático */\r\n    --shadow-sm: 0 2px 10px rgba(63, 16, 66, 0.1);\r\n    --shadow-md: 0 4px 20px rgba(63, 16, 66, 0.08);\r\n    --shadow-lg: 0 8px 30px rgba(63, 16, 66, 0.12);\r\n    --shadow-xl: 0 20px 60px rgba(63, 16, 66, 0.2);\r\n    \r\n    /* Tipografia */\r\n    --font-family: 'Inter', 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;\r\n    --font-size-xs: 0.75rem;\r\n    --font-size-sm: 0.875rem;\r\n    --font-size-base: 1rem;\r\n    --font-size-lg: 1.125rem;\r\n    --font-size-xl: 1.25rem;\r\n    --font-size-2xl: 1.5rem;\r\n    --font-size-3xl: 1.875rem;\r\n    \r\n    /* Espaçamentos */\r\n    --spacing-xs: 0.25rem;\r\n    --spacing-sm: 0.5rem;\r\n    --spacing-md: 1rem;\r\n    --spacing-lg: 1.5rem;\r\n    --spacing-xl: 2rem;\r\n    --spacing-2xl: 3rem;\r\n    \r\n    /* Transições */\r\n    --transition-fast: 0.15s ease;\r\n    --transition-base: 0.3s ease;\r\n    --transition-slow: 0.5s ease;\r\n}\r\n\r\n/* ===== RESET E BASE ===== */\r\n* {\r\n    box-sizing: border-box;\r\n}\r\n\r\nbody {\r\n    font-family: var(--font-family);\r\n    background: linear-gradient(135deg, #f8f5ff 0%, #f0ebff 100%);\r\n    margin: 0;\r\n    padding: 20px;\r\n    min-height: 100vh;\r\n    color: var(--text-primary);\r\n    line-height: 1.6;\r\n}\r\n\r\n/* ===== CONTAINER PRINCIPAL ===== */\r\n.checkpoint-container {\r\n    max-width: 1200px;\r\n    margin: 0 auto;\r\n    background: var(--bg-primary);\r\n    border-radius: var(--border-radius-lg);\r\n    box-shadow: var(--shadow-xl);\r\n    overflow: hidden;\r\n}\r\n\r\n/* ===== HEADER ===== */\r\n.checkpoint-header {\r\n    background: linear-gradient(135deg, #3f1042 0%, #5a1a5d 100%);\r\n    color: white;\r\n    padding: 40px;\r\n    position: relative;\r\n    overflow: hidden;\r\n}\r\n\r\n.checkpoint-header::before {\r\n    content: '';\r\n    position: absolute;\r\n    top: -50%;\r\n    right: -50%;\r\n    width: 200%;\r\n    height: 200%;\r\n    background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);\r\n    animation: float 6s ease-in-out infinite;\r\n}\r\n\r\n@keyframes float {\r\n    0%, 100% { transform: translateY(0px) rotate(0deg); }\r\n    50% { transform: translateY(-20px) rotate(180deg); }\r\n}\r\n\r\n.header-content {\r\n    position: relative;\r\n    z-index: 2;\r\n    text-align: center;\r\n}\r\n\r\n.header-content h1 {\r\n    font-size: var(--font-size-3xl);\r\n    font-weight: 800;\r\n    margin: 0;\r\n    text-shadow: 0 4px 8px rgba(0,0,0,0.3);\r\n    letter-spacing: -1px;\r\n}\r\n\r\n.header-content .subtitle {\r\n    font-size: var(--font-size-lg);\r\n    opacity: 0.9;\r\n    margin-top: 15px;\r\n    font-weight: 300;\r\n}\r\n\r\n/* ===== CONTEÚDO ===== */\r\n.checkpoint-content {\r\n    padding: 50px;\r\n}\r\n\r\n.section-title {\r\n    color: var(--text-primary);\r\n    font-size: var(--font-size-2xl);\r\n    font-weight: 700;\r\n    margin-bottom: 30px;\r\n    text-align: center;\r\n    position: relative;\r\n}\r\n\r\n.section-title::after {\r\n    content: '';\r\n    position: absolute;\r\n    bottom: -10px;\r\n    left: 50%;\r\n    transform: translateX(-50%);\r\n    width: 100px;\r\n    height: 4px;\r\n    background: linear-gradient(135deg, #3f1042 0%, #5a1a5d 100%);\r\n    border-radius: 2px;\r\n}\r\n\r\n/* ===== DASHBOARD DE ESTATÍSTICAS ===== */\r\n.stats-dashboard {\r\n    background: linear-gradient(135deg, #f8f5ff 0%, #f0ebff 100%);\r\n    border-radius: var(--border-radius-lg);\r\n    padding: 40px;\r\n    margin-bottom: 40px;\r\n    box-shadow: var(--shadow-md);\r\n}\r\n\r\n.stats-grid {\r\n    display: grid;\r\n    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\r\n    gap: 30px;\r\n}\r\n\r\n.stat-card {\r\n    background: var(--bg-primary);\r\n    border-radius: var(--border-radius);\r\n    padding: 30px;\r\n    text-align: center;\r\n    box-shadow: var(--shadow-md);\r\n    border: 1px solid var(--border-color);\r\n    transition: var(--transition-base);\r\n    position: relative;\r\n    overflow: hidden;\r\n}\r\n\r\n.stat-card::before {\r\n    content: '';\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n    right: 0;\r\n    height: 4px;\r\n    background: linear-gradient(135deg, #3f1042 0%, #5a1a5d 100%);\r\n}\r\n\r\n.stat-card:hover {\r\n    transform: translateY(-5px);\r\n    box-shadow: var(--shadow-lg);\r\n}\r\n\r\n.stat-card .icon {\r\n    width: 50px;\r\n    height: 50px;\r\n    background: linear-gradient(135deg, #3f1042 0%, #5a1a5d 100%);\r\n    border-radius: 50%;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    margin: 0 auto 20px;\r\n    color: white;\r\n    font-size: 1.5rem;\r\n}\r\n\r\n.stat-card .number {\r\n    font-size: var(--font-size-2xl);\r\n    font-weight: 800;\r\n    color: var(--text-primary);\r\n    margin-bottom: 10px;\r\n}\r\n\r\n.stat-card .label {\r\n    color: var(--text-secondary);\r\n    font-size: var(--font-size-sm);\r\n    text-transform: uppercase;\r\n    font-weight: 600;\r\n    letter-spacing: 1px;\r\n}\r\n\r\n/* ===== PAINEL DE CONTROLES ===== */\r\n.controls-panel {\r\n    background: linear-gradient(135deg, #f8f5ff 0%, #f0ebff 100%);\r\n    border-radius: var(--border-radius-lg);\r\n    padding: 40px;\r\n    margin-bottom: 40px;\r\n    box-shadow: var(--shadow-md);\r\n}\r\n\r\n.controls-grid {\r\n    display: grid;\r\n    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\r\n    gap: 25px;\r\n}\r\n\r\n.control-group {\r\n    display: flex;\r\n    flex-direction: column;\r\n}\r\n\r\n.control-label {\r\n    font-size: var(--font-size-sm);\r\n    font-weight: 700;\r\n    color: var(--text-primary);\r\n    margin-bottom: 10px;\r\n    text-transform: uppercase;\r\n    letter-spacing: 1px;\r\n}\r\n\r\n/* ===== FORMULÁRIOS ===== */\r\n.form-control {\r\n    border: 2px solid var(--border-color);\r\n    border-radius: var(--border-radius-sm);\r\n    padding: 12px 16px;\r\n    font-size: var(--font-size-sm);\r\n    transition: var(--transition-base);\r\n    background: var(--bg-primary);\r\n    color: var(--text-primary);\r\n}\r\n\r\n.form-control:focus {\r\n    border-color: var(--primary-color);\r\n    box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);\r\n    outline: none;\r\n}\r\n\r\n.form-control::placeholder {\r\n    color: var(--text-muted);\r\n}\r\n\r\n/* ===== SEÇÃO DE MEMBROS ===== */\r\n.members-section {\r\n    background: linear-gradient(135deg, #f8f5ff 0%, #f0ebff 100%);\r\n    border-radius: var(--border-radius-lg);\r\n    padding: 40px;\r\n    margin-bottom: 40px;\r\n    box-shadow: var(--shadow-md);\r\n}\r\n\r\n.members-grid {\r\n    display: grid;\r\n    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));\r\n    gap: 25px;\r\n}\r\n\r\n.member-card {\r\n    background: var(--bg-primary);\r\n    border-radius: var(--border-radius);\r\n    padding: 25px;\r\n    text-align: center;\r\n    box-shadow: var(--shadow-md);\r\n    border: 1px solid var(--border-color);\r\n    transition: var(--transition-base);\r\n    cursor: pointer;\r\n    position: relative;\r\n    overflow: hidden;\r\n}\r\n\r\n.member-card::before {\r\n    content: '';\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n    right: 0;\r\n    height: 4px;\r\n    background: linear-gradient(135deg, #3f1042 0%, #5a1a5d 100%);\r\n}\r\n\r\n.member-card:hover {\r\n    transform: translateY(-5px);\r\n    box-shadow: var(--shadow-lg);\r\n}\r\n\r\n.member-card.present {\r\n    border-color: var(--success-color);\r\n    background: linear-gradient(135deg, #f8f5ff 0%, #f0ebff 100%);\r\n}\r\n\r\n.member-card.absent {\r\n    border-color: var(--danger-color);\r\n    background: linear-gradient(135deg, #f8f5ff 0%, #f0ebff 100%);\r\n}\r\n\r\n.member-photo {\r\n    width: 80px;\r\n    height: 80px;\r\n    border-radius: 50%;\r\n    object-fit: cover;\r\n    margin: 0 auto 20px;\r\n    border: 3px solid var(--border-color);\r\n    transition: var(--transition-base);\r\n}\r\n\r\n.member-card.present .member-photo {\r\n    border-color: var(--success-color);\r\n}\r\n\r\n.member-card.absent .member-photo {\r\n    border-color: var(--danger-color);\r\n}\r\n\r\n.member-name {\r\n    font-size: var(--font-size-lg);\r\n    font-weight: 700;\r\n    color: var(--text-primary);\r\n    margin-bottom: 8px;\r\n}\r\n\r\n.member-role {\r\n    font-size: var(--font-size-sm);\r\n    color: var(--text-secondary);\r\n    text-transform: uppercase;\r\n    font-weight: 600;\r\n    letter-spacing: 1px;\r\n    margin-bottom: 20px;\r\n}\r\n\r\n/* ===== BADGES DE STATUS ===== */\r\n.status-badge {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    gap: 8px;\r\n    padding: 8px 16px;\r\n    border-radius: 25px;\r\n    font-size: var(--font-size-xs);\r\n    font-weight: 700;\r\n    text-transform: uppercase;\r\n    letter-spacing: 1px;\r\n}\r\n\r\n.status-badge::before {\r\n    content: '';\r\n    width: 8px;\r\n    height: 8px;\r\n    border-radius: 50%;\r\n}\r\n\r\n.status-present {\r\n    background: linear-gradient(135deg, #f0ebff 0%, #e8e0ff 100%);\r\n    color: var(--success-color);\r\n    border: 1px solid var(--success-color);\r\n}\r\n\r\n.status-present::before {\r\n    background: var(--success-color);\r\n}\r\n\r\n.status-absent {\r\n    background: linear-gradient(135deg, #f0ebff 0%, #e8e0ff 100%);\r\n    color: var(--danger-color);\r\n    border: 1px solid var(--danger-color);\r\n}\r\n\r\n.status-absent::before {\r\n    background: var(--danger-color);\r\n}\r\n\r\n/* ===== BOTÕES ===== */\r\n.btn {\r\n    border: none;\r\n    padding: 12px 24px;\r\n    font-weight: 700;\r\n    text-transform: uppercase;\r\n    letter-spacing: 1px;\r\n    border-radius: 25px;\r\n    transition: var(--transition-base);\r\n    cursor: pointer;\r\n    text-decoration: none;\r\n    display: inline-flex;\r\n    align-items: center;\r\n    gap: 8px;\r\n    font-size: var(--font-size-sm);\r\n}\r\n\r\n.btn-primary {\r\n    background: linear-gradient(135deg, #5fb51b 0%, #1e5d1a 100%);\r\n    color: white;\r\n}\r\n\r\n.btn-primary:hover {\r\n    transform: translateY(-2px);\r\n    box-shadow: 0 8px 25px rgba(63, 16, 66, 0.3);\r\n    color: white;\r\n}\r\n\r\n.btn-secondary {\r\n    background: linear-gradient(135deg, #2399cf 0%, #0c4999 100%);\r\n    color: white;\r\n}\r\n\r\n.btn-secondary:hover {\r\n    transform: translateY(-2px);\r\n    box-shadow: 0 8px 25px rgba(90, 26, 93, 0.3);\r\n    color: white;\r\n}\r\n\r\n.btn-success {\r\n    background: linear-gradient(135deg, #e0c60e 0%, #908d08 100%);\r\n    color: white;\r\n}\r\n\r\n.btn-success:hover {\r\n    transform: translateY(-2px);\r\n    box-shadow: 0 8px 25px rgba(74, 26, 77, 0.3);\r\n    color: white;\r\n}\r\n\r\n.btn-danger {\r\n    background: linear-gradient(135deg, #fe1515 0%, #9a3a9d 100%);\r\n    color: white;\r\n}\r\n\r\n.btn-danger:hover {\r\n    transform: translateY(-2px);\r\n    box-shadow: 0 8px 25px rgba(139, 42, 142, 0.3);\r\n    color: white;\r\n}\r\n\r\n/* ===== MODAIS ===== */\r\n.modal-header {\r\n    background: linear-gradient(135deg, #3f1042 0%, #5a1a5d 100%);\r\n    color: white;\r\n    border-bottom: none;\r\n}\r\n\r\n.modal-title {\r\n    font-weight: 700;\r\n    text-transform: uppercase;\r\n    letter-spacing: 1px;\r\n}\r\n\r\n.modal-body {\r\n    padding: 30px;\r\n}\r\n\r\n.form-group {\r\n    margin-bottom: 20px;\r\n}\r\n\r\n.form-label {\r\n    font-weight: 700;\r\n    color: var(--text-primary);\r\n    margin-bottom: 8px;\r\n    display: block;\r\n}\r\n\r\n.btn-close {\r\n    filter: invert(1);\r\n}\r\n\r\n/* ===== BUSCA ===== */\r\n.search-container {\r\n    position: relative;\r\n    margin-bottom: 20px;\r\n}\r\n\r\n.search-results {\r\n    position: absolute;\r\n    top: 100%;\r\n    left: 0;\r\n    right: 0;\r\n    background: var(--bg-primary);\r\n    border: 2px solid var(--border-color);\r\n    border-top: none;\r\n    border-radius: 0 0 var(--border-radius-sm) var(--border-radius-sm);\r\n    max-height: 200px;\r\n    overflow-y: auto;\r\n    z-index: 1000;\r\n    display: none;\r\n    box-shadow: var(--shadow-md);\r\n}\r\n\r\n.search-result-item {\r\n    padding: 12px 16px;\r\n    cursor: pointer;\r\n    border-bottom: 1px solid #f1f3f4;\r\n    transition: var(--transition-base);\r\n}\r\n\r\n.search-result-item:hover {\r\n    background: linear-gradient(135deg, #f8f5ff 0%, #f0ebff 100%);\r\n}\r\n\r\n.search-result-item:last-child {\r\n    border-bottom: none;\r\n}\r\n\r\n/* ===== NOTIFICAÇÕES ===== */\r\n.haklai-notification {\r\n    position: fixed;\r\n    top: 20px;\r\n    right: 20px;\r\n    z-index: 9999;\r\n    min-width: 300px;\r\n    padding: 15px 20px;\r\n    border-radius: var(--border-radius-sm);\r\n    box-shadow: var(--shadow-lg);\r\n    color: white;\r\n    font-weight: 600;\r\n    transform: translateX(400px);\r\n    transition: var(--transition-base);\r\n}\r\n\r\n.haklai-notification.show {\r\n    transform: translateX(0);\r\n}\r\n\r\n.haklai-notification.success {\r\n    background: var(--success-color);\r\n}\r\n\r\n.haklai-notification.error {\r\n    background: var(--danger-color);\r\n}\r\n\r\n.haklai-notification.warning {\r\n    background: var(--warning-color);\r\n}\r\n\r\n.haklai-notification.info {\r\n    background: var(--info-color);\r\n}\r\n\r\n/* ===== ACESSO NEGADO ===== */\r\n.haklai-access-denied {\r\n    padding: 40px 20px;\r\n    min-height: 400px;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n}\r\n\r\n.haklai-access-denied .card {\r\n    border: none;\r\n    box-shadow: var(--shadow-lg);\r\n    border-radius: var(--border-radius-lg);\r\n}\r\n\r\n/* ===== ESTADOS DE LOADING ===== */\r\n.loading {\r\n    opacity: 0.6;\r\n    pointer-events: none;\r\n    position: relative;\r\n}\r\n\r\n.loading::after {\r\n    content: '';\r\n    position: absolute;\r\n    top: 50%;\r\n    left: 50%;\r\n    width: 20px;\r\n    height: 20px;\r\n    margin: -10px 0 0 -10px;\r\n    border: 2px solid var(--primary-color);\r\n    border-top: 2px solid transparent;\r\n    border-radius: 50%;\r\n    animation: spin 1s linear infinite;\r\n}\r\n\r\n@keyframes spin {\r\n    0% { transform: rotate(0deg); }\r\n    100% { transform: rotate(360deg); }\r\n}\r\n\r\n/* ===== RESPONSIVIDADE ===== */\r\n@media (max-width: 768px) {\r\n    body {\r\n        padding: 10px;\r\n    }\r\n    \r\n    .checkpoint-content {\r\n        padding: 30px;\r\n    }\r\n    \r\n    .stats-grid {\r\n        grid-template-columns: repeat(2, 1fr);\r\n        gap: 15px;\r\n    }\r\n    \r\n    .members-grid {\r\n        grid-template-columns: repeat(2, 1fr);\r\n        gap: 15px;\r\n    }\r\n    \r\n    .member-card {\r\n        padding: 15px;\r\n    }\r\n    \r\n    .member-photo {\r\n        width: 50px;\r\n        height: 50px;\r\n    }\r\n    \r\n    .member-name {\r\n        font-size: var(--font-size-sm);\r\n    }\r\n    \r\n    .member-role {\r\n        font-size: var(--font-size-xs);\r\n    }\r\n    \r\n    .status-badge {\r\n        padding: 6px 12px;\r\n        font-size: var(--font-size-xs);\r\n    }\r\n    \r\n    .controls-grid {\r\n        grid-template-columns: 1fr;\r\n        gap: 15px;\r\n    }\r\n    \r\n    .btn {\r\n        width: 100%;\r\n        justify-content: center;\r\n        margin-bottom: 10px;\r\n    }\r\n}\r\n\r\n@media (max-width: 480px) {\r\n    .checkpoint-header {\r\n        padding: 20px;\r\n    }\r\n    \r\n    .header-content h1 {\r\n        font-size: var(--font-size-2xl);\r\n    }\r\n    \r\n    .header-content .subtitle {\r\n        font-size: var(--font-size-base);\r\n    }\r\n    \r\n    .stats-grid {\r\n        grid-template-columns: 1fr;\r\n    }\r\n    \r\n    .members-grid {\r\n        grid-template-columns: 1fr;\r\n    }\r\n}\r\n\r\n/* ===== TEMA ESCURO ===== Edição Ricardo Noleto Sarmento - 05/10/2025*/\r\n@media (prefers-color-scheme: dark) {\r\n    :root {\r\n        --text-primary: #230129;\r\n        --text-secondary: #2c002f;\r\n        --text-muted: #230129;\r\n        --bg-primary: #f3f3f3;\r\n        --bg-secondary: #c1b5c0;\r\n        --bg-tertiary: #99279e;\r\n        --border-color: #720776;\r\n    }\r\n    body {\r\n        background: linear-gradient(135deg, #3f1042 0%, #5a1a5d 100%);\r\n    }\r\n    \r\n    .checkpoint-container {\r\n        background: var(--bg-primary);\r\n        border: 1px solid var(--border-color);\r\n    }\r\n    \r\n    .form-control {\r\n        background: var(--bg-secondary);\r\n        border-color: var(--border-color);\r\n        color: var(--text-primary);\r\n    }\r\n    \r\n    .form-control:focus {\r\n        background: var(--bg-secondary);\r\n        border-color: var(--primary-color);\r\n    }\r\n    \r\n    .search-results {\r\n        background: var(--bg-secondary);\r\n        border-color: var(--border-color);\r\n    }\r\n    \r\n    .search-result-item:hover {\r\n        background: var(--bg-tertiary);\r\n    }\r\n}\r\n\r\n/* ===== IMPRESSÃO ===== */\r\n@media print {\r\n    body {\r\n        background: white !important;\r\n        padding: 0 !important;\r\n    }\r\n    \r\n    .checkpoint-header {\r\n        background: white !important;\r\n        color: black !important;\r\n        border-bottom: 2px solid #ccc;\r\n    }\r\n    \r\n    .btn {\r\n        display: none !important;\r\n    }\r\n    \r\n    .modal {\r\n        display: none !important;\r\n    }\r\n    \r\n    .checkpoint-container {\r\n        box-shadow: none !important;\r\n        border: 1px solid #ccc;\r\n    }\r\n}\r\n\r\n/* ===== UTILITÁRIOS ===== */\r\n.text-center { text-align: center; }\r\n.text-left { text-align: left; }\r\n.text-right { text-align: right; }\r\n\r\n.mt-1 { margin-top: var(--spacing-xs); }\r\n.mt-2 { margin-top: var(--spacing-sm); }\r\n.mt-3 { margin-top: var(--spacing-md); }\r\n.mt-4 { margin-top: var(--spacing-lg); }\r\n.mt-5 { margin-top: var(--spacing-xl); }\r\n\r\n.mb-1 { margin-bottom: var(--spacing-xs); }\r\n.mb-2 { margin-bottom: var(--spacing-sm); }\r\n.mb-3 { margin-bottom: var(--spacing-md); }\r\n.mb-4 { margin-bottom: var(--spacing-lg); }\r\n.mb-5 { margin-bottom: var(--spacing-xl); }\r\n\r\n.me-1 { margin-right: var(--spacing-xs); }\r\n.me-2 { margin-right: var(--spacing-sm); }\r\n.me-3 { margin-right: var(--spacing-md); }\r\n.me-4 { margin-right: var(--spacing-lg); }\r\n.me-5 { margin-right: var(--spacing-xl); }\r\n\r\n.ms-1 { margin-left: var(--spacing-xs); }\r\n.ms-2 { margin-left: var(--spacing-sm); }\r\n.ms-3 { margin-left: var(--spacing-md); }\r\n.ms-4 { margin-left: var(--spacing-lg); }\r\n.ms-5 { margin-left: var(--spacing-xl); }\r\n\r\n.d-none { display: none !important; }\r\n.d-block { display: block !important; }\r\n.d-flex { display: flex !important; }\r\n.d-grid { display: grid !important; }\r\n\r\n.justify-content-center { justify-content: center; }\r\n.justify-content-between { justify-content: space-between; }\r\n.justify-content-around { justify-content: space-around; }\r\n\r\n.align-items-center { align-items: center; }\r\n.align-items-start { align-items: flex-start; }\r\n.align-items-end { align-items: flex-end; }\r\n\r\n"
