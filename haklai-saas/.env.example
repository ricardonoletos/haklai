# =================================================================
# HAKLAI SAAS - ENVIRONMENT CONFIGURATION
# Copie este arquivo para .env e configure suas variáveis
# =================================================================

# Aplicação
APP_NAME="Haklai SaaS"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_KEY=

# Banco de Dados
DB_HOST=localhost
DB_PORT=3306
DB_NAME=haklai_saas
DB_USER=root
DB_PASS=

# Email (SMTP para 2FA)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-app
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@haklai.com
MAIL_FROM_NAME="Haklai SaaS"

# Google Maps API
GOOGLE_MAPS_API_KEY=

# Segurança
SESSION_LIFETIME=10080
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=30
