# =================================================================
# HAKLAI SAAS - Apache Configuration
# Rewrite rules para hospedagem compartilhada
# =================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Redireciona tudo para public/
    RewriteRule ^$ public/ [L]
    RewriteRule (.*) public/$1 [L]
</IfModule>

# Previne listagem de diretórios
Options -Indexes

# Proteção de arquivos sensíveis
<FilesMatch "\.(env|sql|log|md|json|lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>
